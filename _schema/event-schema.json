{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DHS Conference Event",
  "type": "object",
  "required": ["category", "title", "day", "date", "start_time", "end_time", "visibility"],
  "properties": {
    "category": {
      "type": "string",
      "enum": ["academic", "workshop", "keynote", "meeting", "social", "film", "registration", "welcome", "other"]
    },
    "title": {
      "type": "string"
    },
    "subtitle": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "day": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
    },
    "end_time": {
      "type": "string",
      "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$"
    },
    "location": {
      "type": "string"
    },
    "room": {
      "type": ["string", "null"]
    },
    "visibility": {
      "type": "string",
      "enum": ["public", "editors", "organisers"]
    },
    "panels": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/panel"
      }
    }
  },
  "definitions": {
    "panel": {
      "type": "object",
      "properties": {
        "panel_title": {
          "type": "string"
        },
        "chair": {
          "type": "string"
        },
        "papers": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/paper"
          }
        }
      }
    },
    "paper": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "affiliation": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subject": {
          "type": "string"
        }
      }
    }
  }
}
